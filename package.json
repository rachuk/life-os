{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:create-local": "tsx scripts/create-local-db.ts",
    "user:create": "tsx scripts/user.ts create",
    "user:reset-password": "tsx scripts/user.ts reset-password",
    "user:list": "tsx scripts/user.ts list",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "worker": "tsx worker/index.ts",
    "bot:poll": "tsx scripts/bot-poll.ts",
    "bot:webhook": "tsx scripts/bot-webhook.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "vapid": "tsx scripts/gen-vapid.ts"
  },
  "dependencies": {
    "grammy": "1.46.0",
    "lucide-react": "1.66.0",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
