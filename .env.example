# ---------------------------------------------------------------------------
# Life OS — environment variables. Copy to .env.local (dev) or .env (Docker).
# Never commit real values. Everything optional degrades to an honest manual mode.
# ---------------------------------------------------------------------------

# PostgreSQL connection (plain Postgres 15+). The app switches to role lifeos_user per request (RLS).
DATABASE_URL=postgres://lifeos:change-me@localhost:5432/lifeos
# Only for `pnpm test` — this database's schema is DROPPED and recreated on every run.
TEST_DATABASE_URL=postgres://lifeos:change-me@localhost:5432/lifeos_test
DATABASE_POOL_MAX=10

# Public base URL (used for CSRF origin checks, Telegram webhook, links in messages). https:// in production.
APP_URL=http://localhost:3000
# closed (default): accounts only via `pnpm user:create`; open: sign-up form on /login (dev/test only).
SIGNUP_MODE=closed

# Secrets — generate with: openssl rand -hex 32
MEDIA_SIGNING_SECRET=
CRON_SECRET=

# Private file storage (photos, voice). Must NOT be inside /public. Mount a volume in Docker.
STORAGE_DIR=./data/media
MAX_UPLOAD_MB=15

# --- Telegram (optional; free). Create a bot with @BotFather. ---
ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token (webhook mode).
TELEGRAM_WEBHOOK_SECRET=

# --- Web Push (optional; free). Generate keys: pnpm vapid ---
ENABLE_WEB_PUSH=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- AI (optional). Any OpenAI-compatible endpoint: OpenAI, local Ollama, whisper.cpp server. ---
ENABLE_AI_VOICE=true
ENABLE_AI_INTENT=true
ENABLE_AI_IMAGES=true
ENABLE_AI_WEEKLY_REVIEW=true
# Speech-to-text. OpenAI: leave BASE_URL empty and set the key; whisper.cpp server: http://whisper:8080/v1
AI_TRANSCRIBE_BASE_URL=
AI_TRANSCRIBE_API_KEY=
AI_TRANSCRIBE_MODEL=whisper-1
# Text + vision. Ollama example: AI_LLM_BASE_URL=http://localhost:11434/v1, AI_LLM_MODEL=gemma4:12b, AI_VISION_MODEL=qwen3-vl:4b-instruct
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_MS=60000
# Per-user daily cap on external AI requests.
AI_DAILY_REQUEST_LIMIT=100

ENABLE_REWARDS=true
ENABLE_FITNESS_CATALOG=true
ENABLE_CALENDAR=false

# Worker loop interval
WORKER_INTERVAL_MS=30000
